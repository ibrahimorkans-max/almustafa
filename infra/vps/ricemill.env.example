# Rice Mill ERP — production environment. provision.sh copies this to /etc/ricemill/ricemill.env
# (root:ricemill 0640) and fills in APP_KEY, APP_URL, DB_PASSWORD, RICEMILL_BACKUP_KEY and
# RICEMILL_BLIND_INDEX_KEY with fresh random values. Never commit the filled-in file.
APP_NAME="Rice Mill ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ricemill
DB_USERNAME=ricemill
DB_PASSWORD=

HASH_DRIVER=argon2id
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mail (approval notices, audit anchor). Fill in your SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Security ---
RICEMILL_SA_REQUIRE_IP_ALLOWLIST=true
RICEMILL_SA_REQUIRE_TRUSTED_DEVICE=true
# true only while signing in the very first Super Admin device, then back to false.
RICEMILL_BOOTSTRAP_TRUST_FIRST_DEVICE=false
RICEMILL_HSTS=true
RICEMILL_BLIND_INDEX_KEY=

# --- Backups (phase 9) ---
# Keep a copy of this key OFF the server: without it no backup can be restored.
RICEMILL_BACKUP_KEY=
RICEMILL_BACKUP_DRILL_DATABASE=ricemill_drill
RICEMILL_AUDIT_ANCHOR_EMAIL=
RICEMILL_BACKUP_OFFSITE_DISK=offsite
RICEMILL_OFFSITE_ENDPOINT=
RICEMILL_OFFSITE_REGION=auto
RICEMILL_OFFSITE_BUCKET=
RICEMILL_OFFSITE_KEY=
RICEMILL_OFFSITE_SECRET=
RICEMILL_FAILED_LOGIN_BURST=30

# --- GST / TDS (switch on only when the mill is notified / liable) ---
RICEMILL_EINVOICE_ENABLED=false
RICEMILL_EINVOICE_PROVIDER=sandbox
RICEMILL_REQUIRE_EWAY_FOR_GATE_PASS=false
RICEMILL_TDS_194Q_ENABLED=false
RICEMILL_ARCHIVE_RETENTION_MONTHS=24
