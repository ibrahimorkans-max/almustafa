APP_NAME="MillNexa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=UTC
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ricemill
DB_USERNAME=ricemill
DB_PASSWORD=
HASH_DRIVER=argon2id
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true

# --- Al Mustafa Rice Mills ERP ---
RICEMILL_SA_REQUIRE_IP_ALLOWLIST=true
RICEMILL_SA_REQUIRE_TRUSTED_DEVICE=true
# Set true only while installing (first Super Admin device), then false.
RICEMILL_BOOTSTRAP_TRUST_FIRST_DEVICE=false
RICEMILL_HSTS=true
RICEMILL_SCREEN_GUARD=true

# Pakistan tax (rates change with each Finance Act — confirm with the tax adviser). Sales tax applies only
# when the mill's STRN is entered under Entities; withholding u/s 153 only when the mill is a withholding agent.
RICEMILL_FURTHER_TAX_ENABLED=true
RICEMILL_FURTHER_TAX_RATE_BP=400
RICEMILL_WHT_ENABLED=false
RICEMILL_WHT_THRESHOLD_PAISE=7500000
RICEMILL_WHT_RATE_FILER_BP=550
RICEMILL_WHT_RATE_NON_FILER_BP=1100
RICEMILL_ARCHIVE_RETENTION_MONTHS=24

# Payroll alerts (nightly scan): overtime hours a month per employee, and gross pay change vs last month (bp; 1500 = 15 %).
RICEMILL_OVERTIME_ALERT_HOURS=60
RICEMILL_PAYROLL_VARIANCE_BP=1500

# Backups and monitoring (phase 9). Generate the key with `php artisan backup:key`; keep a copy off the server.
RICEMILL_BACKUP_KEY=
RICEMILL_BACKUP_DRILL_DATABASE=
RICEMILL_BACKUP_OFFSITE_DISK=
RICEMILL_AUDIT_ANCHOR_EMAIL=
# Folder of pg_dump / pg_restore when they are not on PATH (e.g. C:\Users\you\dev\tools\pgsql\bin).
RICEMILL_PG_BIN=
RICEMILL_FAILED_LOGIN_BURST=30

# Access security add-on: extra recipients of lockdown, duress and lost-device alerts (comma-separated).
RICEMILL_SECURITY_CONTACT_EMAILS=
# Approved devices only (everyone | selected | off); production template: everyone. Passkeys need http://localhost, not 127.0.0.1.
RICEMILL_TRUSTED_DEVICES=off
# Mobile numbers for SMS alerts; recorded in the log channel below until an SMS provider is configured.
RICEMILL_SECURITY_CONTACT_SMS=
RICEMILL_SECURITY_SMS_LOG_CHANNEL=stack
RICEMILL_DORMANT_DAYS=30

# Documents: path to pdftoppm (poppler-utils) for PNG output; empty = find it on the PATH.
RICEMILL_PDFTOPPM=

# Action chatbot: offline commands without a key; normal sentences with an Anthropic API key
RICEMILL_ASSISTANT=true
ANTHROPIC_API_KEY=
RICEMILL_ASSISTANT_MODEL=claude-sonnet-5-5

# Mill server mode (see docs/mill-server.md)
RICEMILL_MILL_SERVER=false

# Exact place of sign-ins (area, city, region, country) from the browser's position.
# nominatim = OpenStreetMap over the internet (or your own Nominatim server at RICEMILL_GEOCODER_URL); off = mill sites only (offline).
RICEMILL_GEOCODER=nominatim
RICEMILL_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
RICEMILL_GEOCODER_EMAIL=

# Messages to parties (Masters → Party messages). Empty: messages wait there for sending by hand.
# WhatsApp Business Cloud API (Meta): approved template with body "{{1}}".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=mill_update
WHATSAPP_TEMPLATE_LANGUAGE=en
# Firebase Cloud Messaging: service account key file under storage/app/private (never in public/).
FIREBASE_CREDENTIALS=firebase-service-account.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
RICEMILL_PORTAL_URL=

# SaaS: product name, free trial and contact (customers are opened only by the platform admin)
SAAS_PRODUCT_NAME="MillNexa"
SAAS_TRIAL_DAYS=14
SAAS_TRIAL_PLAN=standard
SAAS_CONTACT=

# SaaS billing: monthly invoices (issued on the 1st), paid by bank transfer
SAAS_INVOICE_DUE_DAYS=10
SAAS_GRACE_DAYS=7
SAAS_SUSPEND_AFTER_DAYS=0
SAAS_INVOICE_PREFIX=SUB
SAAS_SELLER_NAME=
SAAS_SELLER_ADDRESS=
SAAS_SELLER_NTN=
SAAS_BANK_TITLE=
SAAS_BANK_NAME=
SAAS_BANK_ACCOUNT=
SAAS_BANK_IBAN=

# The reverse proxy / load balancer in front of the app, if any (comma-separated IPs or CIDR ranges).
# Empty: none trusted (right for nginx/Apache + PHP on the same server). Never "*".
TRUSTED_PROXIES=
