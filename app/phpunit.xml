<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default test run: PostgreSQL (row-level security is exercised).
  DB_PASSWORD and APP_KEY come from .env.testing (git-ignored) or the CI environment.
  MariaDB/MySQL run: vendor/bin/pest -c phpunit.mariadb.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="ARGON_MEMORY" value="8192"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="ricemill_test"/>
        <env name="DB_USERNAME" value="ricemill"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="RICEMILL_SA_REQUIRE_IP_ALLOWLIST" value="false"/>
        <env name="RICEMILL_SA_REQUIRE_TRUSTED_DEVICE" value="true"/>
        <env name="RICEMILL_BOOTSTRAP_TRUST_FIRST_DEVICE" value="false"/>
        <env name="RICEMILL_GEOCODER" value="off"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
